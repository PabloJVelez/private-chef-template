{
  "name": "medusa",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "nukedb": "docker compose down -v && docker compose up -d",
    "prepare": "medusa db:create --db chef-template && medusa db:migrate && medusa db:sync-links",
    "build": "medusa build",
    "build:prod": "medusa build && mkdir -p build && cp -r .medusa/client/* build/",
    "build:standalone": "medusa build && cd .medusa/server && npm install",
    "lint": "eslint .",
    "seed": "medusa exec ./src/scripts/old-scripts/seed.ts",
    "seed:menus": "medusa exec ./src/scripts/old-scripts/seed-menus.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "dev:all": "concurrently -n medusa,email -c blue,green \"medusa develop\" \"yarn dev:email\"",
    "dev:email": "email dev --dir ./src/modules/resend/emails --port 3001",
    "sync": "medusa db:sync-links",
    "migrate:prod": "medusa db:migrate",
    "start:prod": "medusa db:migrate && medusa start",
    "start:railway": "medusa db:migrate && medusa start",
    "start:standalone": "cd .medusa/server && npm start",
    "seed:prod": "medusa exec ./src/scripts/init.js && npm run add-user:prod",
    "ensure-system-charge-product": "medusa exec ./src/scripts/ensure-system-charge-product.ts",
    "ensure-system-charge-product:prod": "medusa exec ./src/scripts/ensure-system-charge-product.js",
    "add-user:prod": "medusa user --email pmltechpile@gmail.com --password passw0rd!",
    "migrate": "medusa db:migrate",
    "predeploy": "medusa db:migrate",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "init": "medusa exec ./src/scripts/init.ts && yarn add-user",
    "init:prod": "medusa exec ./src/scripts/init.js && npm run add-user:prod",
    "medusa:init": "yarn run nukedb && medusa db:create --db chef-template && yarn run migrate && yarn run sync && yarn run init",
    "reset:prod": "medusa db:drop && medusa db:create --db chef-template && yarn run migrate && yarn run sync && yarn run init:prod",
    "medusa:init:prod": "npm run migrate:prod && npm run sync && npm run init:prod",
    "create:medusadb": "medusa db:create --db chef-template",
    "add-user": "medusa user --email pmltechpile@gmail.com --password \"password!\"",
    "fix-tickets": "medusa exec ./src/scripts/fix-event-ticket-inventory-shipping.ts",
    "fix-tickets-delivered": "medusa exec ./src/scripts/backfill-event-ticket-fulfillments-delivered.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@lambdacurry/medusa-product-reviews": "patch:@lambdacurry/medusa-product-reviews@npm%3A1.4.0#~/.yarn/patches/@lambdacurry-medusa-product-reviews-npm-1.4.0-32743d7e1e.patch",
    "@medusajs/admin-sdk": "2.22.6",
    "@medusajs/cli": "2.22.6",
    "@medusajs/file-s3": "2.22.6",
    "@medusajs/framework": "2.22.6",
    "@medusajs/icons": "2.22.6",
    "@medusajs/js-sdk": "2.22.6",
    "@medusajs/medusa": "2.22.6",
    "@medusajs/types": "2.22.6",
    "@medusajs/ui": "4.2.13",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation-express": "^0.54.0",
    "@opentelemetry/instrumentation-http": "^0.205.0",
    "@opentelemetry/instrumentation-pg": "^0.58.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@react-email/components": "^0.3.2",
    "@sentry/node": "^10.11.0",
    "@types/luxon": "^3.6.2",
    "@unlockable/vite-plugin-unlock": "^0.1.6",
    "date-fns": "^4.1.0",
    "ioredis": "^5.11.1",
    "posthog-node": "^4.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^4.7.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "^2.17.1",
    "@medusajs/test-utils": "2.22.6",
    "@react-email/preview-server": "4.2.4",
    "@stdlib/number-float64-base-normalize": "0.0.8",
    "@swc/core": "1.15.43",
    "@swc/jest": "0.2.39",
    "@types/express": "4.17.25",
    "@types/jest": "^29.5.12",
    "@types/mime": "1.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.14",
    "@typescript/typescript6": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react-email": "^4.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.0",
    "yalc": "^1.0.0-pre.53"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "engines": {
    "node": "26.13.1"
  }
}
