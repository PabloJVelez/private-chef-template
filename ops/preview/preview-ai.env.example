# Copy outside Git to a mode0600 operator file; set ai_env_file in controller config.
# This overrides the app model only for managed previews. Never commit a real key.
CHEF_AI_SCOPE=single_site
CHEF_AI_PROVIDER=openai
CHEF_AI_MODEL=gpt-5.4-mini
CHEF_AI_OPENAI_API_KEY=
CHEF_AI_SCHEDULE_WRITE_ENABLED=true
